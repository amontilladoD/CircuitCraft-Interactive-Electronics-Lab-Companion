<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal">

    <com.circuitcraft.app.sim.SimulatorView
        android:id="@+id/simView"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" />

    <ScrollView
        android:layout_width="210dp" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="4dp">

            <Button android:id="@+id/btnRun"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="▶ Run" />
            <Button android:id="@+id/btnView"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="🔍 View" />
            <Button android:id="@+id/btnRotate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="⟳ Rotate" />
            <Button android:id="@+id/btnValue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="✎ Value" />
            <Button android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="🗑 Delete" />
            <Button android:id="@+id/btnCheck"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="⚠ Check" />
            <Button android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="⭐ Save" />

            <TextView android:id="@+id/tvStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="6dp" android:textSize="12sp" android:background="@color/status_bg" android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:paddingStart="6dp"
                android:text="Parts" android:textStyle="bold" android:textColor="@color/primary" />

            <!-- same id as portrait; buttons are added in code (vertical here) -->
            <LinearLayout android:id="@+id/paletteRow"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
