<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CircuitCraft" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent</item>
    </style>

    <!-- Splash: fixed blue in both modes, no action bar -->
    <style name="Theme.CircuitCraft.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_dark</item>
    </style>
</resources>
